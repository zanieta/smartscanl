# Copy to .env and fill in. Do NOT commit the real .env.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx   # only needed if you switch back to the Claude provider
NVD_API_KEY=your-nvd-api-key            # optional, raises NVD rate limit 5->50 req/30s
# --- Database (PostgreSQL only) ---
# PostgreSQL is the ONLY supported backend. DATABASE_URL is required — the app
# fails fast at startup if it is unset or not a Postgres URL. SQLite has been retired.
DATABASE_URL=postgresql+psycopg://vulnsense:CHANGE_ME@127.0.0.1:5432/vulnsense

# --- LLM provider for the analysis step ---
# ollama (default) = local, private. claude = Anthropic API; requires a valid
# ANTHROPIC_API_KEY and a CLAUDE_MODEL available to your account.
LLM_PROVIDER=ollama
# Local LLM (Ollama) — used when LLM_PROVIDER=ollama:
OLLAMA_BASE_URL=http://localhost:11434  # or http://<gpu-box-ip>:11434
# Must match a tag that actually exists on the Ollama host — check with
#   curl http://<ollama-host>:11434/api/tags
# A model named here but absent there fails at scan time, not at startup.
OLLAMA_MODEL=gpt-oss:latest
OLLAMA_NUM_CTX=8192
# Cloud LLM (Claude) — used only when LLM_PROVIDER=claude.
CLAUDE_MODEL=claude-sonnet-5            # or claude-haiku-4-5 for lower cost

# --- Auth / accounts ---
SESSION_SECRET=change-me-to-a-long-random-string   # signs the login cookie; a stable value keeps sessions across restarts
# COOKIE_SECURE=1 adds the Secure flag to the session cookie (send over HTTPS only).
# Leave UNSET for Phase 0 plain-HTTP (WSL2); set to 1 on the TLS server (Phase 1).
COOKIE_SECURE=
ADMIN_USERNAME=admin                               # seeded on first run only (when no users exist)
ADMIN_PASSWORD=changeme                            # CHANGE THIS — only used to seed the first admin

# --- Break-glass account -------------------------------------------------
# A 2FA-exempt super-admin, for when the last admin loses their authenticator.
# It signs in on a password ALONE, so treat this value like a root password:
# long, random, and stored in your secret manager. Every login by it is audited.
# If BREAKGLASS_PASSWORD is unset the app generates one and prints it to the log
# exactly once at startup.
BREAKGLASS_USERNAME=dewebnetadmin
BREAKGLASS_PASSWORD=                               # set on the server; never commit a real value

# Every other account must enrol a TOTP authenticator on first login, and new
# account passwords must be at least 8 characters (auth.MIN_PASSWORD_LEN).

# --- Web scanner ---------------------------------------------------------
# The passive web scanner refuses targets that resolve to private, loopback,
# link-local, reserved or cloud-metadata addresses (an SSRF guard). Set this to 1
# ONLY on an internal deployment that is meant to scan RFC1918 hosts. Leaving it
# on lets any authenticated operator make the server fetch its own metadata
# endpoint, so keep it unset for anything internet-facing.
WEB_SCAN_ALLOW_PRIVATE=

# Opt-in active discovery. Explicit RFC1918 IPv4 CIDRs only; no auto-detected scope.
# Maximum 4 non-overlapping ranges, each /24 or smaller. Ubuntu timer is separate.
NETWORK_DISCOVERY_ENABLED=0
NETWORK_DISCOVERY_CIDRS=
