[Unit]
Description=VulnSense approved-network device discovery
After=network-online.target postgresql.service vulnsense.service
Wants=network-online.target

[Service]
Type=oneshot
User=vulnsense
WorkingDirectory=/opt/vulnsense
EnvironmentFile=/opt/vulnsense/.env
ExecStart=/opt/vulnsense/.venv/bin/python -m scripts.discover_network
TimeoutStartSec=7min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
